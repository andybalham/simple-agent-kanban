{
  "name": "local-agent-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first Kanban console for trusted coding agents.",
  "packageManager": "npm@10",
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:mcp": "tsx src/mcp/index.ts",
    "cleanup:dev": "node tools/cleanup-dev-artifacts.mjs",
    "migrate:single-db": "tsx tools/migrate-single-db-to-project-dbs.ts",
    "backup:registry": "tsx tools/backup-registry.ts",
    "check:phase8": "tsx tools/check-phase8.ts",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "check:phase0": "node tools/check-phase0.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.9.0",
    "drizzle-orm": "^0.45.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.26.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "prettier": "^3.5.3",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
